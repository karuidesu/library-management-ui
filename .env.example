# ==============================================================================
# Dupliquez ce fichier en .env ou .env.local pour configurer votre environnement
# ==============================================================================

# URL de l'API Backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

NEXT_PUBLIC_APP_NAME=Agbale
NEXT_PUBLIC_ORGANIZATION_NAME=Bibliothèque Centrale
NEXT_PUBLIC_DEFAULT_MAX_BOOKS=5
NEXT_PUBLIC_DEFAULT_LOAN_DURATION_DAYS=21
NEXT_PUBLIC_AUTH_TOKEN_KEY=agbale:auth_token

# Données simulées (true = mock local, false = backend réel)
NEXT_PUBLIC_USE_MOCK_DATA=true
